# Copy to ignored .env.rf4; use only with compose.rf4-readonly.yaml after scoping.
# Networking stays disabled until an approved real-source trial is ready.
LINKMIND_CONNECTOR_NETWORK=0
# Each value is a JSON object. Configure an app-owned, owner-bound read credential.
# {"authorization":"Bearer ..."} or Atlassian native {"authorization":"Basic ..."}
# Do not paste credentials into the UI, chat, reports or tracked files.
RF4_ATLASSIAN_READ={}
RF4_ATLASSIAN_MCP={}
RF4_MICROSOFT_READ={}
# Optional app-owned delegated OAuth registration (not end-user credentials).
# Populate only in the ignored private deployment environment file, never in the UI.
LINKMIND_PUBLIC_ORIGIN=http://127.0.0.1:5195
LINKMIND_OAUTH_PROVIDERS_JSON={}
# Production: mount a Fernet key outside the database and set its absolute path.
# Local demo only: a private key is created once in the shared artifacts volume.
# LINKMIND_CONNECTION_KEY_FILE=/run/secrets/linkmind-connection-key
